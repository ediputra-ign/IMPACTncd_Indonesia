---
xps_name: BMI
outcome: obesity
lag: 0
distribution: lognormal
source: guideline_driven
notes: The usual 27 kg/m2 cut-off #edited 20260205 using 27 kg/m2 as Indonesia cut off
apply_rr_extra_fn: >
  function(sp) {
    if (!inherits(sp, 'SynthPop')) stop('Argument sp needs to be a SynthPop object.')
    sp$pop[, BMI_rr := BMI >= BMI_rr] # TRUE = obese, FALSE is not
  }
