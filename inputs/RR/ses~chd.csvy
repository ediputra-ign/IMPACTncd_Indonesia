---
xps_name: ses
outcome: chd
lag: 0
distribution: lognormal
source: The  Lancet https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(16)32380-7/fulltext Figure 4
notes: HRs were mutually adjusted for age, sex, SES, marital status, race, smoking, DM, physical inactivity, alcohol, hypertension, obesity 
apply_rr_extra_fn: >
  function(sp) {
    if (!inherits(sp, 'SynthPop')) stop('Argument sp needs to be a SynthPop object.')
    # multiplier for the risk of CHD for lower ses
    if (!'chd_incd_ses_mltp' %in% names(sp$pop)) sp$pop[, chd_incd_ses_mltp := ses_rr]
    if (!'chd_mrtl_ses_mltp' %in% names(sp$pop)) sp$pop[, chd_mrtl_ses_mltp := ses_rr]
    # sp$pop[ses == 0L, ses_rr := 1]
  }
